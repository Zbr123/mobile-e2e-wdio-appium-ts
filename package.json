{
  "name": "mobile-e2e-wdio-appium-ts",
  "version": "1.0.0",
  "private": true,
  "description": "Reference mobile E2E + API suite: WebdriverIO 9, Appium 3, TypeScript, Mocha, page objects. Hybrid login, deep links, push, GraphQL/REST, EAS builds in GitHub Actions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint:selectors": "node scripts/guard-selectors.mjs",
    "test:android": "wdio run config/wdio.android.conf.ts",
    "test:ios": "wdio run config/wdio.ios.conf.ts",
    "test:bs": "wdio run config/wdio.browserstack.conf.ts",
    "test:api": "mocha --import=tsx --timeout 30000 'tests/api/**/*.spec.ts'",
    "smoke:android": "wdio run config/wdio.android.conf.ts --mochaOpts.grep @smoke",
    "smoke:ios": "wdio run config/wdio.ios.conf.ts --mochaOpts.grep @smoke",
    "build:find": "tsx scripts/find-eas-build.ts",
    "appium:doctor": "appium driver doctor uiautomator2 && appium driver doctor xcuitest"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@wdio/appium-service": "^9.33.1",
    "@wdio/browserstack-service": "^9.44.3",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/junit-reporter": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "@wdio/types": "^9.33.1",
    "appium": "~3.9.1",
    "appium-uiautomator2-driver": "~8.7.3",
    "appium-xcuitest-driver": "~12.22.8",
    "dotenv": "^16.6.1",
    "expect": "^29.7.0",
    "mocha": "^11.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "webdriverio": "^9.33.1",
    "zod": "^3.24.0"
  }
}

# ---- App under test (placeholders: point these at a real build) ----
ANDROID_APP_PACKAGE=com.example.petcare
ANDROID_APP_PATH=./apps/petcare.apk
IOS_BUNDLE_ID=com.example.petcare
IOS_APP_PATH=./apps/PetCare.app
APP_SCHEME=petcare

# ---- Where to run ----
# Emulator/simulator by default. For a real device set the UDID (adb devices / xcrun xctrace list devices).
ANDROID_UDID=
IOS_UDID=
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=
IOS_REAL_DEVICE=false
IOS_XCODE_ORG_ID=

# ---- Test users (Salesforce sandbox users with identity verification disabled) ----
E2E_USER=
E2E_PASSWORD=
E2E_USER_2=
E2E_PASSWORD_2=

# ---- BFF (NestJS GraphQL + REST) used for API tests and test-data setup ----
BFF_URL=https://bff.staging.example.com
GRAPHQL_PATH=/graphql
E2E_API_TOKEN=
E2E_API_TOKEN_2=

# ---- Push ----
# Android emulators can't fake a push locally, so tests send a real one via Expo's push API.
EXPO_PUSH_TOKEN_ANDROID=

# ---- BrowserStack ----
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_ANDROID_APP=
BROWSERSTACK_IOS_APP=
